{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ANPR: Debug pipeline (via CLI)",
      "type": "debugpy",
      "request": "launch",
      "module": "anpr.cli",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--video",
        "${workspaceFolder}/data/videos/clip_1.mp4",
        "--config",
        "${workspaceFolder}/config.yaml",
        "--output",
        "${workspaceFolder}/output/output_tracked_1.mp4"
      ]
    }
  ]
}
